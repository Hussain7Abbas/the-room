; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Room"
run/main_scene="res://core/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://core/Events.cs"
Tuning="*res://core/TuningService.cs"
Net="*res://core/Net.cs"
PingService="*res://core/PingService.cs"
CombatServer="*res://core/CombatServer.cs"
MatchServer="*res://core/MatchServer.cs"
SeasonStats="*res://core/SeasonStats.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="The Room"

[editor]

version_control/autoload_on_startup=true

