<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TheRoom</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.47" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- services/ holds standalone .NET apps (the lobby). They build on their own and must not be
         compiled into the game assembly. -->
    <Compile Remove="services/**" />
    <Content Remove="services/**" />
    <None Remove="services/**" />
  </ItemGroup>
</Project>
