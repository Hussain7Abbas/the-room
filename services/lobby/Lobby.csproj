<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- net8.0 matches the .NET 8 runtime already on the VPS. RollForward lets it run on a newer
         local runtime too (dev machines with only .NET 9/10 installed). -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheRoom.Lobby</RootNamespace>
    <AssemblyName>TheRoom.Lobby</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
</Project>
